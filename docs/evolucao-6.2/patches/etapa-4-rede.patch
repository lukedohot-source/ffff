+ // são fáceis de perder de vista numa troca de paleta, então ficam medidos, não no olho.
+ static double Channel(int v){
+  double s=v/255.0;
+  return s<=0.04045?s/12.92:Math.Pow((s+0.055)/1.055,2.4);
+ }
+ static double Luminance(Color c){return 0.2126*Channel(c.R)+0.7152*Channel(c.G)+0.0722*Channel(c.B);}
+ static double Contrast(Color a,Color b){
+  double la=Luminance(a),lb=Luminance(b);
+  return (Math.Max(la,lb)+0.05)/(Math.Min(la,lb)+0.05);
+ }
+ static void Readable(Color ink,Color back,string label){
+  double ratio=Contrast(ink,back);
+  if(ratio<4.5)throw new Exception("6.2 contraste insuficiente em "+label+": "+ratio.ToString("0.00")+":1");
+ }
