+ // Conferido nos testes e antes de qualquer alteração em lote: a lista opcional não
+ // pode conter nada da lista protegida, e todo serviço precisa de nível e descrição.
+ internal static void ValidateServiceCatalog(){
+  foreach(var entry in OptionalServices){
+   if(ProtectedServices.Contains(entry.Key))throw new Exception("Serviço protegido na lista opcional: "+entry.Key);
+   if(String.IsNullOrWhiteSpace(entry.Value))throw new Exception("Serviço sem descrição de impacto: "+entry.Key);
+   if(!ServiceTiers.ContainsKey(entry.Key))throw new Exception("Serviço sem nível declarado: "+entry.Key);
+   string tier=ServiceTiers[entry.Key];
+   if(tier!="leve"&&tier!="agressivo"&&tier!="extremo")throw new Exception("Nível inválido em "+entry.Key+": "+tier);
+  }
+  foreach(var entry in ServiceTiers)
+   if(!OptionalServices.ContainsKey(entry.Key))throw new Exception("Nível declarado para serviço fora da lista opcional: "+entry.Key);
+ }
