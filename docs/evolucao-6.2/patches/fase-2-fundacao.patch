+  if(busType==17)return "NVMe";
+  if(mediaType==4)return "SSD";
+  if(mediaType==3)return "HD";
+  if(mediaType==5)return "Memória persistente";
+  return "";
+ }
+ static string SystemDriveMediaType(string root){
