+        # executavel recem-compilado parece velho. Hash nao depende de relogio.
+        [IO.File]::WriteAllText(($taskLauncher + '.sha256'), $taskShipped.ToLowerInvariant(), (New-Object Text.UTF8Encoding($false)))
