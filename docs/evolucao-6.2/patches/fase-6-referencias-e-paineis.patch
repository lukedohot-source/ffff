diff -ruN '--exclude=*.exe' '--exclude=*.log' '--exclude=*.zip' head12/LukeOptimizer-6.1.2/codigo-fonte/LukeOptimizer/tests/PanelUiTests.cs work/LukeOptimizer-6.1.2/codigo-fonte/LukeOptimizer/tests/PanelUiTests.cs
