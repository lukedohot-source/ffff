+    & .\UiSmoke.exe (Join-Path $taskResults 'interface') *> (Join-Path $taskResults 'ui.log')
+    if ($LASTEXITCODE -ne 0) { throw 'Testes de interface falharam. Executavel principal preservado.' }
+    if (-not $OnlyTest) {
+        Copy-Item -LiteralPath 'source\app.config' -Destination 'LukeOptimizer-Engine.exe.config' -Force
+        Copy-Item -LiteralPath 'source\app.config' -Destination (Join-Path $taskRoot 'native\LukeOptimizer-Engine.exe.config') -Force
+        Copy-Item -LiteralPath 'source\app.config' -Destination (Join-Path $taskRoot 'native\LukeOptimizer-v5.exe.config') -Force
+        Copy-Item -LiteralPath '.\LukeOptimizer-Engine.new.exe' -Destination '.\LukeOptimizer-Engine.exe' -Force
+        Copy-Item -LiteralPath '.\LukeOptimizer-Engine.new.exe' -Destination (Join-Path $taskRoot 'native\LukeOptimizer-Engine.exe') -Force
+        Copy-Item -LiteralPath '.\LukeOptimizer-Engine.new.exe' -Destination (Join-Path $taskRoot 'native\LukeOptimizer-v5.exe') -Force
+        # ABRIR.cmd executa native\LukeOptimizer-6.1.2.exe. Esse arquivo NAO era publicado
+        # aqui: a compilacao atualizava Engine.exe e v5.exe, e o atalho do usuario continuava
+        # abrindo o binario antigo. Compilar dava certo e nada mudava na tela.
+        $taskLauncher = Join-Path $taskRoot 'native\LukeOptimizer-6.1.2.exe'
+        Copy-Item -LiteralPath '.\LukeOptimizer-Engine.new.exe' -Destination $taskLauncher -Force
+        Copy-Item -LiteralPath 'source\app.config' -Destination (Join-Path $taskRoot 'native\LukeOptimizer-6.1.2.exe.config') -Force
+        # Confere que o arquivo que ABRIR.cmd abre e mesmo o que acabou de ser compilado.
+        # Sem isto, qualquer erro de copia volta a ser silencioso.
+        $taskBuilt = (Get-FileHash -LiteralPath '.\LukeOptimizer-Engine.new.exe' -Algorithm SHA256).Hash
+        $taskShipped = (Get-FileHash -LiteralPath $taskLauncher -Algorithm SHA256).Hash
+        if ($taskBuilt -ne $taskShipped) { throw 'O executavel aberto por ABRIR.cmd nao corresponde ao que foi compilado.' }
+        # Carimbo do que ESTA compilacao publicou. ABRIR.cmd compara o hash do executavel
+        # com este arquivo para saber se o binario e o que passou nos testes.
+        # Comparar DATAS nao servia: o ZIP guarda horario local sem fuso (formato DOS),
+        # entao ao extrair num fuso diferente os fontes ganham data no futuro e o
+        # executavel recem-compilado parece velho. Hash nao depende de relogio.
+        [IO.File]::WriteAllText(($taskLauncher + '.sha256'), $taskShipped.ToLowerInvariant(), (New-Object Text.UTF8Encoding($false)))
+        Write-Output ('Publicado em native\LukeOptimizer-6.1.2.exe - SHA256 ' + $taskShipped.ToLowerInvariant())
+    }
+    & (Join-Path $taskRoot 'ATUALIZAR-HASHES.ps1')
+    Get-Content -LiteralPath (Join-Path $taskResults 'tests.log') -Tail 1
+    Get-Content -LiteralPath (Join-Path $taskResults 'ui.log') -Tail 1
+    Write-Output 'Validacao concluida. Nenhuma otimizacao ou desinstalacao real foi executada.'
+} finally { Pop-Location }
