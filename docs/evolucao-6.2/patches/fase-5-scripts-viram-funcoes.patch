+  // pior, porque relançaria o programa com privilégio que ele não tinha antes.
+  if(action=="--services-tier"){ServicesInTier(payload);return true;}
+  if(action=="--reopen-apps")return false;
+  // Comandos de rede exigem administrador; os diagnosticos sao somente leitura.
+  if(action=="--network-action")return NetworkTools.Resolve(payload).Administrator;
+  // Resolve TODOS os ids antes de responder: um id fora da allowlist derruba a chamada
+  // aqui, antes de qualquer elevação, em vez de falhar no meio da sequência já elevada.
